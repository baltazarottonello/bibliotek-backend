{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "generateOptions": {
    "spec": {
      "controller": false,
      "service": false,
      "guard": false,
      "module": false
    }
  },
  "compilerOptions": {
    "deleteOutDir": true
  }
}
